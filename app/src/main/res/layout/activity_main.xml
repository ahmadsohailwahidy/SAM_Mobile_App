<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="30dp"
    android:text="Tempratur Converter"
    android:textStyle="bold"
    android:textSize="24sp" />

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Enter Temperature"
        android:textStyle="bold"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editTemperature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter a number"
        android:layout_marginTop="8dp"
        android:inputType="numberDecimal|numberSigned" />

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Select Conversion"
        android:textSize="16sp"
        android:layout_marginTop="24dp" />
    
    <RadioGroup
        android:id="@+id/radioConversion"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/celceiusConverter"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Farenheit to Celceius" />

        <RadioButton
            android:id="@+id/farenheitConverter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Celceius to Farenheit" />

    </RadioGroup>
    
    <Button
    android:id="@+id/btnOpenResult"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Open Result Activity" />
</LinearLayout>

